# Supply these as private runtime deployment settings. This file has no secrets.
NEXTSTEP_APP_URL=https://nextstep.example.com
NEXTSTEP_SUPABASE_URL=https://project-ref.supabase.co
NEXTSTEP_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Use the restricted nextstep_app login and the transaction pooler. TLS must verify.
NEXTSTEP_DATABASE_URL=postgresql://nextstep_app.project-ref:replace_me@pooler-host:6543/postgres?sslmode=verify-full
# Paste the public database CA certificate from Database Settings. Literal \n is supported.
NEXTSTEP_DATABASE_CA=-----BEGIN CERTIFICATE-----\nreplace_with_public_database_ca\n-----END CERTIFICATE-----
